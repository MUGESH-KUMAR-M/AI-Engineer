# Default LLM: local Ollama (no API key)
MODEL_PROVIDER=ollama
MODEL_NAME=phi3
OLLAMA_API_URL=http://localhost:11434
OLLAMA_TIMEOUT=120

# Embeddings: huggingface (local) | openai
EMBEDDING_PROVIDER=huggingface

# Cloud API keys (optional — or paste via UI Settings → Model)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

CHROMA_PATH=./data/chroma_db
TOP_K=4
PDF_DIR=./Docs
SIMILARITY_THRESHOLD=1.2
