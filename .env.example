# LLM provider: anthropic | openai | gemini | groq | ollama
MODEL_PROVIDER=ollama
MODEL_NAME=llama3
OLLAMA_TIMEOUT=120

# Embeddings: huggingface (local, no key) | openai
EMBEDDING_PROVIDER=huggingface

# API keys (set the one matching MODEL_PROVIDER)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=your_groq_key_here
OLLAMA_API_URL=http://localhost:11434

CHROMA_PATH=./data/chroma_db
TOP_K=4
PDF_DIR=./Docs
